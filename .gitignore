# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust / Tauri build output (several GB)
src-tauri/target/
src-tauri/gen/schemas/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Windows shell leftovers
Thumbs.db
ehthumbs.db
desktop.ini

# Secrets. Nothing here should ever hold one — API keys go to the Windows
# credential store, not a file — but an accidental commit is unrecoverable
# once the repo is public, so the net is worth having.
.env
.env.*
*.pem
*.key

# Python bytecode from running the bridge locally
__pycache__/
*.pyc
